---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import { content } from '../../data/content';

const { sectionTitles, site, contact } = content;
---

<BaseLayout
  site={{
    ...site,
    title: `Contact | ${site.title}`,
    description: 'お問い合わせ',
  }}
>
  <section class="contact-page">
    <div class="contact-page__inner">
      <SectionTitle content={sectionTitles.contact} />
      <p class="contact-page__lead">{contact.lead}</p>

      <!-- SNS（任意） -->

      <p class="contact-page__back">
        <a class="contact-page__back_link" href="/">トップに戻る</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  @use '../../styles/variables' as *;
  @use '../../styles/mixins' as *;

  .contact-page {
    padding-top: 6rem;

    &__inner {
      max-width: 640px; // フォームは狭めの方が読みやすい
      margin: 0 auto;
    }

    &__lead {
      margin: 32px 0 0;
      font-size: 0.8rem;
      letter-spacing: 0.06em;
      opacity: 0.8;
    }

    &__back {
      display: flex;
      justify-content: center;
      margin: 48px 0 0;
    }

    &__back_link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 22px;
      border: 0.5px solid $c-border;
      border-radius: 999px;
      font-size: 0.7rem;
      letter-spacing: 0.2em;
      color: $c-text;
      transition:
        color 0.4s ease,
        background-color 0.4s ease,
        border-color 0.4s ease;

      &:hover {
        color: $c-text-a;
        background-color: $c-bg-a;
        border-color: $c-bg-a;
      }
    }
  }
</style>
