---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import SnsList from '../../components/SnsList.astro';
import PillLink from '../../components/PillLink.astro';
import { content } from '../../data/content';

const { sectionTitles, site, contact } = content;
---

<BaseLayout
  site={{
    ...site,
    title: `Contact | ${site.title}`,
    description: 'お問い合わせ',
  }}
>
  <section class="contact-page">
    <div class="contact-page__inner">
      <SectionTitle content={sectionTitles.contact} />
      <p class="contact-page__lead">{contact.lead}</p>
      <SnsList />
      <p class="contact-page__action">
        <PillLink href={contact.formUrl} ariaLabel="お問い合わせフォームへ（新しいタブで開く）" external>{contact.formLabel}</PillLink>
      </p>
      <p class="contact-page__back">
        <PillLink href="/">トップに戻る</PillLink>
      </p>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  .contact-page {
    padding-top: 6rem;

    &__inner {
      display: flex;
      flex-direction: column;
      max-width: 640px;
      gap: 32px;
      margin: 0 auto;
    }

    &__lead {
      margin: 32px 0 0;
      font-size: 0.8rem;
      letter-spacing: 0.06em;
      opacity: 0.8;
    }

    &__action {
      display: flex;
      justify-content: center;
    }

    &__back {
      display: flex;
      justify-content: center;
    }
  }
</style>
