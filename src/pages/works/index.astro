---
import { getWorks } from '../../lib/microcms';
import { content } from '../../data/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import PillLink from '../../components/PillLink.astro';
import WorkCard from '../../components/WorkCard.astro';


const { sectionTitles, site } = content;
const { contents: works } = await getWorks();
---

<BaseLayout
  site={{
    ...site,
    title: `Works | ${site.title}`,
    description: 'Mechaの制作実績一覧。今まで行った実績を掲載しています。',
  }}
>
  <section class="works">
    <div class="works__inner">
      <SectionTitle content={sectionTitles.works} />
      {
        works.length === 0 ? (
          <p class="works__empty">{sectionTitles.works.empty}</p>
        ) : (
          <ul class="works__list">
            {works.map((work) => (
              <WorkCard work={work} heading="h3" />
            ))}
          </ul>
        )
      }

      <p class="works__back">
        <PillLink href="/">トップに戻る</PillLink>
      </p>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  .works {
    padding-top: 6rem;

    &__inner {
      max-width: $inner;
      margin: 0 auto;
    }

    &__empty {
      text-align: center;
      margin: 32px 0 0;
      font-size: 0.8rem;
      letter-spacing: 0.06em;
      opacity: 0.7;
    }

    &__list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
      margin: 32px 0 0;
    }

    &__back {
      display: flex;
      justify-content: center;
      margin: 48px 0 0;
    }
  }

  @include tab {
    .works {
      &__list {
        grid-template-columns: 1fr;
      }
    }
  }
</style>
