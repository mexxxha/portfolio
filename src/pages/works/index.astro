---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import { content } from '../../data/content';

const { sectionTitles, site } = content;
const works = (await getCollection('works')).sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<BaseLayout
  site={{
    ...site,
    title: `Works | ${site.title}`,
    description: '制作実績一覧',
  }}
>
  <section class="works">
    <div class="works__inner">
      <SectionTitle content={sectionTitles.works} />
      {
        works.length === 0 ? (
          <p class="works__empty">{sectionTitles.works.empty}</p>
        ) : (
          <ul class="works__list">
            {works.map((entry) => (
              <li class="works__item">
                <a class="works__card" href={`/works/${entry.id}`}>
                  <div class="works__media">
                    <Image class="works__image" src={entry.data.thumbnail} alt={entry.data.title} />
                  </div>

                  <div class="works__body">
                    <p class="works__date">{entry.data.date}</p>
                    <h2 class="works__title">{entry.data.title}</h2>
                    <p class="works__desc">{entry.data.description}</p>

                    <ul class="works__tech">
                      {entry.data.tech.map((tech) => (
                        <li class="works__tech_item">{tech}</li>
                      ))}
                    </ul>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <p class="works__back">
        <a class="works__back_link" href="/">トップに戻る</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  @use '../../styles/variables' as *;
  @use '../../styles/mixins' as *;

  .works {
    padding-top: 6rem;

    &__inner {
      max-width: 1100px;
      margin: 0 auto;
    }

    &__empty {
      text-align: center;
      margin: 32px 0 0;
      font-size: 0.8rem;
      letter-spacing: 0.06em;
      opacity: 0.7;
    }

    &__list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
      margin: 32px 0 0;
    }

    &__card {
      display: grid;
      height: 100%;
      gap: 16px;
      padding: 16px;
      border: 0.5px solid $c-border;
      border-radius: 8px;
      transition:
        border-color 0.4s ease,
        transform 0.4s ease;

      &:hover {
        border-color: $c-text;
        transform: translateY(-2px);
      }
    }

    &__media {
      aspect-ratio: 16 / 10;
      border-radius: 4px;
      overflow: hidden;
    }

    &__image {
      height: 100%;
      transition: transform 0.4s ease;

      .works__card:hover & {
        transform: scale(1.03);
      }
    }

    &__body {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    &__date {
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      opacity: 0.7;
    }

    &__title {
      font-size: 1rem;
      line-height: 1.3;
    }

    &__desc {
      font-size: 0.7rem;
      opacity: 0.8;
    }

    &__tech {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 4px 0 0;
    }

    &__tech_item {
      padding: 4px 10px;
      border: 0.5px solid $c-border;
      border-radius: 999px;
      font-size: 0.6rem;
      letter-spacing: 0.06em;
    }

    &__back {
      display: flex;
      justify-content: center;
      margin: 48px 0 0;

      &_link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 22px;
        border: 0.5px solid $c-border;
        border-radius: 999px;
        font-size: 0.7rem;
        letter-spacing: 0.2em;
        color: $c-text;
        transition:
          color 0.4s ease,
          background-color 0.4s ease,
          border-color 0.4s ease;

        &:hover {
          color: $c-text-a;
          background-color: $c-bg-a;
          border-color: $c-bg-a;
        }
      }
    }
  }

  @include tab {
    .works {
      &__list {
        grid-template-columns: 1fr;
      }
    }
  }
</style>
