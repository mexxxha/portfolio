---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { getWorks, type Work } from '../../lib/microcms';
import { content } from '../../data/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';

interface Props {
  work: Work;
}

export async function getStaticPaths() {
  const { contents } = await getWorks();
  return contents.map((work) => ({
    params: { id: work.slug },
    props: { work },
  }));
}

const { work } = Astro.props;
const { site } = content;
const { title, description, publishedAt, type, tech, thumbnail, liveUrl, body } = work;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  description,
  datePublished: publishedAt,
  url: new URL(`/works/${work.slug}`, Astro.site).href,
  ...(liveUrl && { sameAs: liveUrl }),
  inLanguage: 'ja',
  author: {
    '@type': 'Person',
    name: content.about.profile.name,
    url: Astro.site!.href,
  },
  image: thumbnail.url,
  ...(type?.length && { genre: type }),
  ...(tech?.length && { keywords: tech }),
};
---

<BaseLayout
  site={{
    ...site,
    title: `${title} | ${site.title}`,
    description,
    ogImage: thumbnail.url,
  }}
>
  <JsonLd slot="head" data={jsonLd} />
  <article class="work">
    <div class="work__inner">
      <div class="work__meta">
        <span class="work__date">{publishedAt?.slice(0, 10)}</span>
        <ul class="work__types">
          {type.map((item) => <li class="work__type">{item}</li>)}
        </ul>
      </div>

      <h1 class="work__title">{title}</h1>
      <p class="work__desc">{description}</p>

      <div class="work__media">
        <Image class="work__image" src={thumbnail.url} alt={title} inferSize />
      </div>

      <ul class="work__tech">
        {tech.map((item) => <li class="work__tech_item">{item}</li>)}
      </ul>

      {
        liveUrl && (
          <p class="work__external">
            <a class="work__external_link" href={liveUrl} aria-label="View Site（新しいタブで開く）" target="_blank" rel="noopener noreferrer">
              View Site
              <Icon class="work__external_icon" name="ei:external-link" aria-hidden="true" />
            </a>
          </p>
        )
      }

      <div class="work__content" set:html={body} />

      <nav class="work__nav" aria-label="作品ページのナビ">
        <a class="work__nav_link" href="/works">一覧に戻る</a>
        <a class="work__nav_link" href="/">トップに戻る</a>
      </nav>
    </div>
  </article>
</BaseLayout>

<style lang="scss">
  .work {
    padding: 6rem 24px 4rem;

    &__inner {
      max-width: 800px;
      margin: 0 auto;
    }

    &__meta {
      display: flex;
      gap: 12px;
      margin: 0 0 12px;
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      opacity: 0.7;
    }

    &__types {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    &__type {
      border: 0.5px solid $c-border;
      border-radius: 999px;
      padding: 4px 10px;
      font-size: 0.6rem;
      letter-spacing: 0.06em;
    }

    &__title {
      margin: 0 0 12px;
      font-size: clamp(1.6rem, 3vw, 2.2rem);
      line-height: 1;
    }

    &__desc {
      margin: 0 0 28px;
      font-size: 0.9rem;
      opacity: 0.8;
    }

    &__media {
      aspect-ratio: 16 / 10;
      overflow: hidden;
      border-radius: 8px;
      border: 0.5px solid $c-border;
    }

    &__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    &__tech {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 20px 0 0;

      &_item {
        border: 0.5px solid $c-border;
        border-radius: 999px;
        padding: 4px 10px;
        font-size: 0.6rem;
        letter-spacing: 0.06em;
      }
    }

    &__external {
      margin: 24px 0 0;

      &_link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 22px;
        border: 0.5px solid $c-border;
        border-radius: 999px;
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        color: $c-text;
        transition:
          color 0.4s ease,
          background-color 0.4s ease,
          border-color 0.4s ease;

        &:hover {
          color: $c-text-a;
          background-color: $c-bg-a;
          border-color: $c-bg-a;
        }
      }

      &_icon {
        width: 20px;
        height: 20px;
      }
    }

    &__content {
      margin-top: 40px;
      font-size: 0.9rem;

      :global(h2) {
        margin: 2em 0 0.7em;
        font-size: 1rem;
      }

      :global(p) {
        margin: 0 0 1em;
      }

      :global(ul) {
        margin: 0 0 1em;
        padding-left: 1em;
        list-style: disc;
      }

      :global(li + li) {
        margin-top: 0.3em;
      }
    }

    &__nav {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 56px;

      &_link {
        display: inline-flex;
        align-items: center;
        padding: 10px 22px;
        border: 0.5px solid $c-border;
        border-radius: 999px;
        font-size: 0.7rem;
        letter-spacing: 0.2em;
        color: $c-text;
        transition:
          color 0.4s ease,
          background-color 0.4s ease,
          border-color 0.4s ease;

        &:hover {
          color: $c-text-a;
          background-color: $c-bg-a;
          border-color: $c-bg-a;
        }
      }
    }
  }
</style>
