---
import BaseLayout from '../layouts/BaseLayout.astro';
import About from '../sections/About.astro';
import Skills from '../sections/Skills.astro';
import PillLink from '../components/PillLink.astro';
import { content } from '../data/content';

const { site, aboutPage } = content;
---

<BaseLayout
  site={{
    ...site,
    title: `About | ${site.title}`,
    description: 'プロフィール・経歴',
  }}
>
  <div class="about">
    <About detail />
    <Skills />

    <section class="about__history">
      <h2 class="about__history_title">History</h2>
      <ol class="about__history_list">
        {
          aboutPage.history.map((item) => (
            <li class="about__history_item">
              <p class="about__history_year">{item.year}</p>
              <div class="about__history_body">
                <h3 class="about__history_name">{item.title}</h3>
                <p class="about__history_desc">{item.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <p class="about__back">
      <PillLink href="/">トップに戻る</PillLink>
    </p>
  </div>
</BaseLayout>

<style lang="scss">
  .about {
    max-width: 1100px;
    margin: 0 auto;
    padding: 6rem 24px;

    &__history {
      margin-top: 100px;

      &_title {
        font-size: 0.8rem;
        letter-spacing: 0.1em;
        opacity: 0.6;
      }

      &_list {
        margin-top: 24px;
        border-top: 0.5px solid $c-border;
      }

      &_item {
        display: flex;
        gap: 32px;
        padding: 20px 0;
        border-bottom: 0.5px solid $c-border;
      }

      &_year {
        flex-shrink: 0;
        width: 80px;
        font-size: 0.7rem;
        letter-spacing: 0.08em;
        opacity: 0.6;
      }

      &_name {
        font-size: 0.9rem;
        letter-spacing: 0.06em;
      }

      &_desc {
        margin-top: 6px;
        font-size: 0.7rem;
        opacity: 0.7;
      }
    }

    &__back {
      display: flex;
      justify-content: center;
      margin: 80px 0 0;
    }
  }

  @include tab {
    .about {
      &__history_item {
        flex-direction: column;
        gap: 8px;
      }
    }
  }
</style>
