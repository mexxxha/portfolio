---
import { Image } from 'astro:assets';
import { getBlogs, type Blog } from '../../lib/microcms';
import { content } from '../../data/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';

interface Props {
  post: Blog;
}
export async function getStaticPaths() {
  const { contents } = await getBlogs();
  return contents.map((post) => ({
    params: { id: post.slug },
    props: { post },
  }));
}
const { post } = Astro.props;
const { site } = content;
const { title, description, publishedAt, tags, thumbnail, body } = post;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: publishedAt,
  url: new URL(`/blog/${post.slug}`, Astro.site).href,
  inLanguage: 'ja',
  author: {
    '@type': 'Person',
    name: content.about.profile.name,
    url: Astro.site!.href,
  },
  ...(thumbnail && { image: thumbnail.url }),
  ...(tags?.length && { keywords: tags }),
};
---

<BaseLayout
  site={{
    ...site,
    title: `${title} | ${site.title}`,
    description,
    ogImage: thumbnail?.url ?? site.ogImage,
  }}
>
  <JsonLd slot="head" data={jsonLd} />
  <article class="blog">
    <div class="blog__inner">
      <p class="blog__date">{publishedAt?.slice(0, 10)}</p>
      <h1 class="blog__title">{title}</h1>
      <p class="blog__desc">{description}</p>

      {
        tags && (
          <ul class="blog__tags">
            {tags.map((tag) => (
              <li class="blog__tag_item">{tag}</li>
            ))}
          </ul>
        )
      }

      {
        thumbnail && (
          <div class="blog__media">
            <Image class="blog__image" src={thumbnail.url} alt={title} inferSize />
          </div>
        )
      }

      <div class="blog__content" set:html={body} />

      <nav class="blog__nav" aria-label="ブログページのナビ">
        <a class="blog__nav_link" href="/blog">一覧に戻る</a>
        <a class="blog__nav_link" href="/">トップに戻る</a>
      </nav>
    </div>
  </article>
</BaseLayout>

<style lang="scss">
  .blog {
    padding: 6rem 24px 4rem;

    &__inner {
      max-width: 800px;
      margin: 0 auto;
    }

    &__date {
      margin: 0 0 12px;
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      opacity: 0.7;
    }

    &__title {
      margin: 0 0 12px;
      font-size: clamp(1rem, 3vw, 2rem);
      line-height: 1.2;
    }

    &__desc {
      margin: 0 0 20px;
      font-size: 0.9rem;
      opacity: 0.8;
    }

    &__tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 0 0 24px;
    }

    &__tag_item {
      padding: 4px 10px;
      border: 0.5px solid $c-border;
      border-radius: 999px;
      font-size: 0.6rem;
      letter-spacing: 0.06em;
    }

    &__media {
      aspect-ratio: 16 / 10;
      margin-bottom: 40px;
      border-radius: 8px;
      border: 0.5px solid $c-border;
      overflow: hidden;
    }

    &__image {
      height: 100%;
    }

    &__content {
      font-size: 0.9rem;

      :global(h2) {
        margin: 2em 0 0.7em;
        font-size: 1rem;
        font-weight: 700;
      }

      :global(p) {
        margin: 0 0 1em;
      }

      :global(ul) {
        margin: 0 0 1.2em;
        padding-left: 1.2em;
        list-style: disc;
      }

      :global(li + li) {
        margin-top: 0.3em;
      }
    }

    &__nav {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      justify-content: center;
      margin-top: 56px;
    }

    &__nav_link {
      display: inline-flex;
      align-items: center;
      padding: 10px 22px;
      border: 0.5px solid $c-border;
      border-radius: 999px;
      font-size: 0.7rem;
      letter-spacing: 0.2em;
      color: $c-text;
      transition:
        color 0.4s ease,
        background-color 0.4s ease,
        border-color 0.4s ease;

      &:hover {
        color: $c-text-a;
        background-color: $c-bg-a;
        border-color: $c-bg-a;
      }
    }
  }
</style>
