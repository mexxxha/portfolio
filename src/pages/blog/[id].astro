---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { content } from '../../data/content';

interface Props {
  entry: CollectionEntry<'blog'>;
}

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { site } = content;
const { title, description, date, tags, thumbnail } = entry.data;
---

<BaseLayout
  site={{
    ...site,
    title: `${title} | ${site.title}`,
    description,
  }}
>
  <article class="blog">
    <div class="blog__inner">
      <p class="blog__date">{date}</p>
      <h1 class="blog__title">{title}</h1>
      <p class="blog__description">{description}</p>

      {
        tags && (
          <ul class="blog__tags">
            {tags.map((tag) => (
              <li class="blog__tag_item">{tag}</li>
            ))}
          </ul>
        )
      }

      {
        thumbnail && (
          <div class="blog__media">
            <Image class="blog__image" src={thumbnail} alt={title} />
          </div>
        )
      }

      <div class="blog__content">
        <Content />
      </div>

      <nav class="blog__nav" aria-label="ブログページのナビ">
        <a class="blog__nav_link" href="/blog">一覧に戻る</a>
        <a class="blog__nav_link" href="/">トップに戻る</a>
      </nav>
    </div>
  </article>
</BaseLayout>

<style lang="scss">
  @use '../../styles/variables' as *;
  @use '../../styles/mixins' as *;

  .blog {
    padding: 6rem 24px 4rem;

    &__inner {
      max-width: 800px;
      margin: 0 auto;
    }

    &__date {
      margin: 0 0 12px;
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      opacity: 0.7;
    }

    &__title {
      margin: 0 0 12px;
      font-size: clamp(1.6rem, 3vw, 2.2rem);
      line-height: 1.25;
    }

    &__description {
      margin: 0 0 20px;
      font-size: 0.9rem;
      opacity: 0.85;
    }

    &__tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 0 0 24px;
      padding: 0;
      list-style: none;
    }

    &__tag_item {
      border: 0.5px solid $c-border;
      border-radius: 999px;
      padding: 4px 10px;
      font-size: 0.6rem;
      letter-spacing: 0.06em;
    }

    &__media {
      aspect-ratio: 16 / 10;
      overflow: hidden;
      border-radius: 8px;
      border: 0.5px solid $c-border;
      margin-bottom: 40px;
    }

    &__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    &__content {
      font-size: 0.9rem;
      line-height: 1.9;

      :global(h2) {
        margin: 2em 0 0.75em;
        font-size: 1.15rem;
        font-weight: 700;
      }

      :global(p) {
        margin: 0 0 1em;
      }

      :global(ul) {
        margin: 0 0 1.25em;
        padding-left: 1.25em;
        list-style: disc;
      }

      :global(li + li) {
        margin-top: 0.35em;
      }
    }

    &__nav {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      justify-content: center;
      margin-top: 56px;
    }

    &__nav_link {
      display: inline-flex;
      align-items: center;
      padding: 10px 22px;
      border: 0.5px solid $c-border;
      border-radius: 999px;
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      color: $c-text;
      text-decoration: none;
      transition:
        color 0.3s ease,
        background-color 0.3s ease,
        border-color 0.3s ease;

      &:hover {
        color: $c-text-a;
        background-color: $c-bg-a;
        border-color: $c-bg-a;
      }
    }
  }
</style>