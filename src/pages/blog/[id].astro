---
import { microCMSRichEditorHandler, responsiveImageTransformer } from 'microcms-rich-editor-handler';
import { formatPublishedDate } from '../../lib/date';
import { getBlogs, type Blog } from '../../lib/microcms';
import { content } from '../../data/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';

interface Props {
  post: Blog;
}
export async function getStaticPaths() {
  const { contents } = await getBlogs();
  return contents.map((post) => ({
    params: { id: post.slug },
    props: { post },
  }));
}
const { post } = Astro.props;
const { site } = content;
const { title, description, publishedAt, tags, thumbnail, body } = post;
const { html: optimizedBody } = await microCMSRichEditorHandler(body, {
  transformers: [
    responsiveImageTransformer({
      attributes: {
        sizes: 'auto',
      },
      formats: ['default', 'avif'],
      deviceSizes: [480, 768, 1024, 1280],
    }),
  ],
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: publishedAt,
  url: new URL(`/blog/${post.slug}/`, Astro.site).href,
  inLanguage: 'ja',
  author: {
    '@type': 'Person',
    name: content.about.profile.name,
    url: Astro.site!.href,
  },
  ...(thumbnail && { image: thumbnail.url }),
  ...(tags?.length && { keywords: tags }),
};
---

<BaseLayout
  site={{
    ...site,
    title: `${title} | ${site.title}`,
    description,
    ogType: 'article',
    publishedTime: publishedAt,
    ...(thumbnail
      ? {
          ogImage: thumbnail.url,
          ogImageWidth: thumbnail.width,
          ogImageHeight: thumbnail.height,
        }
      : {}),
  }}
>
  <JsonLd slot="head" data={jsonLd} />
  <article class="blog">
    <div class="blog__inner">
      <p class="blog__date">{formatPublishedDate(publishedAt)}</p>
      <h1 class="blog__title">{title}</h1>
      <p class="blog__desc">{description}</p>

      {
        tags && (
          <ul class="blog__tags">
            {tags.map((tag) => (
              <li class="blog__tag_item">{tag}</li>
            ))}
          </ul>
        )
      }

      <div class="blog__content" set:html={optimizedBody} />

      <nav class="blog__nav" aria-label="ブログページのナビ">
        <a class="blog__nav_link" href="/blog/">一覧に戻る</a>
        <a class="blog__nav_link" href="/">トップに戻る</a>
      </nav>
    </div>
  </article>
</BaseLayout>

<style lang="scss">
  .blog {
    padding: 6rem 24px 4rem;

    &__inner {
      max-width: 800px;
      margin: 0 auto;
    }

    &__date {
      margin: 0 0 12px;
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      opacity: 0.7;
    }

    &__title {
      margin: 0 0 12px;
      font-size: clamp(1rem, 3vw, 2rem);
      line-height: 1.2;
    }

    &__desc {
      margin: 0 0 20px;
      font-size: 0.9rem;
      opacity: 0.8;
    }

    &__tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 0 0 24px;
    }

    &__tag_item {
      padding: 4px 10px;
      border: 0.5px solid $c-border;
      border-radius: 999px;
      font-size: 0.6rem;
      letter-spacing: 0.06em;
    }

    &__content {
      font-size: 0.9rem;
      @include rich-text;
    }

    &__nav {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      justify-content: center;
      margin-top: 56px;
    }

    &__nav_link {
      display: inline-flex;
      align-items: center;
      padding: 10px 22px;
      border: 0.5px solid $c-border;
      border-radius: 999px;
      font-size: 0.7rem;
      letter-spacing: 0.2em;
      color: $c-text;
      transition:
        color 0.4s ease,
        background-color 0.4s ease,
        border-color 0.4s ease;

      &:hover {
        color: $c-text-a;
        background-color: $c-bg-a;
        border-color: $c-bg-a;
      }
    }
  }
</style>
