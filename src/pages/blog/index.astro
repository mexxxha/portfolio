---
import { getBlogs } from '../../lib/microcms';
import { content } from '../../data/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import PillLink from '../../components/PillLink.astro';
import BlogCard from '../../components/BlogCard.astro';

const { sectionTitles, site } = content;
const { contents: posts } = await getBlogs();
---

<BaseLayout
  site={{
    ...site,
    title: `Blog | ${site.title}`,
    description: 'Mechaのブログ。制作や学習についてのメモなどを掲載しています。',
  }}
>
  <section class="blog">
    <div class="blog__inner">
      <SectionTitle content={sectionTitles.blog} />
      {
        posts.length === 0 ? (
          <p class="blog__empty">{sectionTitles.blog.empty}</p>
        ) : (
          <ul class="blog__list">
            {posts.map((post) => (
              <BlogCard post={post} heading="h3" />
            ))}
          </ul>
        )
      }

      <p class="blog__back">
        <PillLink href="/">トップに戻る</PillLink>
      </p>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  .blog {
    padding-top: 6rem;

    &__inner {
      max-width: $inner;
      margin: 0 auto;
    }

    &__empty {
      text-align: center;
      margin: 32px 0 0;
      font-size: 0.8rem;
      letter-spacing: 0.06em;
      opacity: 0.7;
    }

    &__list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
      margin: 32px 0 0;
    }

    &__back {
      display: flex;
      justify-content: center;
      margin: 48px 0 0;
    }
  }

  @include tab {
    .blog {
      &__list {
        grid-template-columns: 1fr;
      }
    }
  }
</style>
