---
import '../styles/global.scss';

import type { SiteContent } from '../types/type';
import { ClientRouter } from 'astro:transitions';

import Loading from '../components/Loading.astro';
import ScrollIndicator from '../components/ScrollIndicator.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type Props = {
  site: SiteContent;
};

const { site } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(site.ogImage, Astro.site).href;
---

<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={site.title} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Libre+Barcode+39&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet" />

    <ClientRouter />
    <script is:inline>
      if (sessionStorage.getItem('site-loaded') === '1') {
        document.documentElement.classList.add('is-loaded');
      }
    </script>
  </head>
  <body>
    <Loading />
    <Header />
    <ScrollIndicator />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  import '../scripts/lenis';
</script>
