---
import '../styles/global.scss';

import type { SiteContent } from '../types/type';
import { ClientRouter } from 'astro:transitions';

import Loading from '../components/Loading.astro';
import ScrollIndicator from '../components/ScrollIndicator.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type Props = {
	site: SiteContent;
};

const { site } = Astro.props;
---

<html lang={site.lang} transition:animate="none">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{site.title}</title>
		<meta name="description" content={site.description} />
		<meta property="og:image" content={site.ogImage} />
    <!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Libre+Barcode+39&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">

		<ClientRouter />
	</head>
	<body>
		<Loading />
    <Header />
		<ScrollIndicator />
    <main transition:name="content" transition:animate="fade">
			<slot />
		</main>
    <Footer />
		<script>
			import '../scripts/lenis';
		</script>
	</body>
</html>