---
import { content } from '../data/content';

import SnsList from '../components/SnsList.astro';

const { logo, footer } = content;
const LogoIcon = logo.src;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner">
    <a class="footer__brand" href="/" aria-label={logo.alt}>
      <LogoIcon class="footer__logo" aria-hidden="true" focusable="false" />
    </a>

    <nav class="footer__nav" aria-label="フッターナビゲーション">
      <ul class="footer__nav_list">
        {
          footer.nav.map((item) => (
            <li>
              <a class="footer__nav_link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <SnsList />

    <p class="footer__copyright">&copy; {year} {footer.copyright}</p>
  </div>
</footer>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .footer {
    width: 100%;
    padding: 20px 24px 32px;
    
    &__inner {
      display: grid;
      justify-items: center;
      gap: 32px;
      margin: 0 auto;
      border-top: 0.5px solid $c-border;
    }

    &__brand {
      margin: 20px 0 0;
    }

    &__logo {
      width: 80px;
      height: auto;
      opacity: 0.9;
      transition: opacity 0.4s ease;

      .footer__brand:hover & {
        opacity: 1;
      }
    }

    &__nav_list {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 24px;
    }

    &__nav_link {
      font-size: 0.6rem;
      letter-spacing: 0.1em;
      opacity: 0.7;
      transition: opacity 0.4s ease;

      &:hover {
        opacity: 1;
      }
    }

    &__copyright {
      font-size: 0.6rem;
      letter-spacing: 0.1em;
      opacity: 0.5;
    }
  }

  @include tab {
    .footer {
      padding-top: 48px;

      &__nav_list {
        gap: 16px;
      }
    }
  }
</style>
