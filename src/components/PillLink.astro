---
type Props = {
  href: string;
  external?: boolean;
  ariaLabel?: string;
};

const { href, external = false, ariaLabel } = Astro.props;
---

<a class="pill__link" href={href} aria-label={ariaLabel} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
  <slot />
</a>

<style lang="scss">
  .pill__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 22px;
    border: 0.5px solid $c-border;
    border-radius: 999px;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: $c-text;
    transition:
      color 0.4s ease,
      background-color 0.4s ease,
      border-color 0.4s ease;
    &:hover {
      color: $c-text-a;
      background-color: $c-bg-a;
      border-color: $c-bg-a;
    }
  }
</style>