---
import { Image } from 'astro:assets';
import type { Work } from '../lib/microcms';

type Props = {
  work: Work;
  heading?: 'h2' | 'h3';
  variant?: 'row' | 'stack';
};

const { work, heading: Heading = 'h3', variant = 'stack' } = Astro.props;
const { title, date, description, thumbnail, tech, slug } = work;
---

<li class:list={['work__card', variant === 'row' && 'work__card_row']}>
  <a class="work__card_link" href={`/works/${slug}`} aria-label={`${title}の詳細`}>
    <div class="work__card_media">
      <Image class="work__card_image" src={thumbnail.url} alt={title} inferSize />
    </div>
    <div class="work__card_body">
      <p class="work__card_date">{date.slice(0, 10)}</p>
      <Heading class="work__card_title">{title}</Heading>
      <p class="work__card_desc">{description}</p>
      <ul class="work__card_tech">
        {tech.map((item) => (
          <li class="work__card_item">{item}</li>
        ))}
      </ul>
    </div>
  </a>
</li>


<style lang="scss">
  .work__card {
    &_link {
      display: grid;
      height: 100%;
      gap: 16px;
      padding: 16px;
      border: 0.5px solid $c-border;
      border-radius: 8px;
      transition:
        border-color 0.4s ease;
      
      &:hover {
        border-color: $c-text;
      }
    }

    &_media {
      aspect-ratio: 16 / 10;
      border-radius: 4px;
      overflow: hidden;
    }

    &_image {
      width: 100%;
      height: 100%;
    }

    &_body {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    &_date {
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      opacity: 0.7;
    }

    &_title {
      font-size: 1rem;
      line-height: 1.3;
    }

    &_desc {
      font-size: 0.7rem;
      opacity: 0.8;
    }

    &_tech {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 4px 0 0;
    }

    &_item {
      padding: 4px 10px;
      border: 0.5px solid $c-border;
      border-radius: 999px;
      font-size: 0.6rem;
      letter-spacing: 0.06em;
    }

    &_row {
      .work__card_link {
        grid-template-columns: 1.2fr 1fr;
        gap: 24px;
        padding: 24px;
      }

      .work__card_body {
        justify-content: center;
        gap: 12px;
      }
    }
  }

  @include tab {
    .work__card_row .work__card_link {
      grid-template-columns: 1fr;
    }
  }
</style>
