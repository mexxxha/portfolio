---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

type Props = {
  entry: CollectionEntry<'blog'>;
  heading?: 'h2' | 'h3';
};

const { entry, heading: Heading = 'h3' } = Astro.props;
const { title, date, description, thumbnail, tags } = entry.data;
---

<li class="blog__card">
  <a class="blog__card_link" href={`/blog/${entry.id}`} aria-label={`${title}の記事`}>
    {thumbnail && (
      <div class="blog__card_media">
        <Image class="blog__card_image" src={thumbnail} alt={title} />
      </div>
    )}
    <div class="blog__card_body">
      <p class="blog__card_date">{date}</p>
      <Heading class="blog__card_title">{title}</Heading>
      <p class="blog__card_desc">{description}</p>
      {tags && (
        <ul class="blog__card_tags">
          {tags.map((tag) => (
            <li class="blog__card_item">{tag}</li>
          ))}
        </ul>
      )}
    </div>
  </a>
</li>

<style lang="scss">
  .blog__card {
    &_link {
      display: grid;
      height: 100%;
      gap: 16px;
      padding: 16px;
      border: 0.5px solid $c-border;
      border-radius: 8px;
      transition: border-color 0.4s ease;

      &:hover {
        border-color: $c-text;
      }
    }

    &_media {
      aspect-ratio: 16 / 10;
      border-radius: 4px;
      overflow: hidden;
    }

    &_image {
      width: 100%;
      height: 100%;
    }

    &_body {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    &_date {
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      opacity: 0.7;
    }

    &_title {
      font-size: 1rem;
      line-height: 1.3;
    }

    &_desc {
      font-size: 0.7rem;
      opacity: 0.8;
    }

    &_tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 4px 0 0;
    }

    &_item {
      padding: 4px 10px;
      border: 0.5px solid $c-border;
      border-radius: 999px;
      font-size: 0.6rem;
      letter-spacing: 0.06em;
    }
  }
</style>