---
import type { SectionTitleContent } from '../types/type';

interface Props {
  content: SectionTitleContent;
}

const { content } = Astro.props;
---

<div class="section__title">
  <p class="section__title_sub" data-shuffle-text data-shuffle-original={content.subtitle}>
    {content.subtitle}
  </p>
  <h2 class="section__title_title">{content.title}</h2>
</div>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .section__title {
    &_title {
      font-family: 'Libre Barcode 39', cursive;
      font-size: $fs-display;
      line-height: 1.2;
      letter-spacing: 0.04em;
    }

    &_sub {
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      opacity: 0.7;
    }
  }
</style>

<script>
  import '../scripts/shuffleText';
</script>
