---
import type { SectionTitleContent } from '../types/type';

interface Props {
  content: SectionTitleContent;
  level?: 'h1' | 'h2';
}

const { content, level = 'h2' } = Astro.props;
const Heading = level;
---

<div class="section__title">
  <p class="section__title_sub" data-shuffle-text data-shuffle-original={content.subtitle}>
    {content.subtitle}
  </p>
  <Heading class="section__title_title">{content.title}</Heading>
</div>

<style lang="scss">
  .section__title {
    &_title {
      font-family: 'Libre Barcode 39', cursive;
      font-size: $fs-display;
      line-height: 1.2;
      letter-spacing: 0.04em;
    }

    &_sub {
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      opacity: 0.7;
    }
  }
</style>

<script>
  import '../scripts/shuffleText';
</script>
