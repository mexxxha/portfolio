---
import { content } from '../data/content';

const LogoIcon = content.logo.src;
---

<div class="loading" transition:persist="loading" role="status" aria-live="polite" aria-label="読み込み中">
  <div class="loading__inner">
    <LogoIcon class="loading__logo" data-loading-logo aria-hidden="true" focusable="false" />
    <p class="loading__brand" data-shuffle-text data-shuffle-original="MECHA">MECHA</p>
    <p class="loading__label">Loading</p>
    <div class="loading__bar" aria-hidden="true">
      <span class="loading__bar_fill"></span>
    </div>
  </div>
</div>

<style lang="scss">
  @use '../styles/variables' as *;

  .loading {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    background-color: $c-bg;
    color: $c-text;
    z-index: 9999;
    transition:
      opacity 0.4s ease,
      visibility 0.4s ease;

    &.is-hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    &.is-bg-out {
      transition: background-color 0.4s ease;

      .loading__brand,
      .loading__label,
      .loading__bar {
        opacity: 0;
        transition: opacity 0.4s ease;
      }

      // ロゴ以外のクリック阻害を外す
      pointer-events: none;
    }

    &__inner {
      display: grid;
      justify-items: center;
      gap: 16px;
      width: min(240px, 70vw);
    }

    &__logo {
      width: auto;
      height: 60px;
    }

    &__brand {
      font-size: 1rem;
      letter-spacing: 0.04em;
      line-height: 1;
    }

    &__label {
      font-size: 0.5rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      opacity: 0.7;
    }

    &__bar {
      width: 100%;
      height: 1px;
      background-color: $c-border;
      overflow: hidden;

      &_fill {
        display: block;
        width: 40%;
        height: 100%;
        background-color: $c-bg-a;
        animation: loading-slide 4s ease-in-out infinite;
      }
    }
  }

  @keyframes loading-slide {
    0% {
      transform: translateX(-120%);
    }
    100% {
      transform: translateX(320%);
    }
  }
</style>

<script>
  import '../scripts/loading';
</script>
