---
import { Icon } from 'astro-icon/components';
import { content } from '../data/content';

const { socials } = content;
---

<ul class="sns__list">
  {socials.map((item) => (
    <li>
      <a class="sns__list_link" href={item.href} target="_blank" aria-label={item.ariaLabel} rel="noopener noreferrer">
        <Icon class="sns__list_icon" name={item.icon} />
      </a>
    </li>
  ))}
</ul>

<style lang="scss">
  .sns__list {
    display: flex;
    justify-content: center;
    gap: 10px;

    &_link {
      display: grid;
      place-items: center;
      width: 36px;
      height: 36px;
      border: 0.5px solid $c-border;
      border-radius: 50%;
      opacity: 0.7;
      transition:
        opacity 0.4s ease,
        border-color 0.4s ease;
      
      &:hover {
        opacity: 1;
        border-color: $c-text;
      }
    }

    &_icon {
      width: 14px;
      height: 14px;
    }
  }
</style>