---
import { getBlogs } from '../lib/microcms';
import { content } from '../data/content';
import SectionTitle from '../components/SectionTitle.astro';
import PillLink from '../components/PillLink.astro';
import BlogCard from '../components/BlogCard.astro';

const { sectionTitles } = content;
const { contents } = await getBlogs();
const items = contents.slice(0, 2);
const hasMore = contents.length > 2;
---

<section class="blog" id="blog">
  <div class="blog__inner">
    <SectionTitle content={sectionTitles.blog} />
    {
      items.length === 0 ? (
        <p class="blog__empty">{sectionTitles.blog.empty}</p>
      ) : (
        <>
          <ul class="blog__list">
            {items.map((post) => (
              <BlogCard post={post} heading="h3" />
            ))}
          </ul>

          {hasMore && (
            <p class="blog__more">
              <PillLink href="/blog">MORE</PillLink>
            </p>
          )}
        </>
      )
    }
  </div>
</section>

<style lang="scss">
  .blog {
    &__inner {
      max-width: $inner;
      margin: 0 auto;
    }

    &__empty {
      text-align: center;
      margin: 32px 0 0;
      font-size: 0.8rem;
      letter-spacing: 0.06em;
      opacity: 0.7;
    }

    &__list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
      margin: 32px 0 0;
    }

    &__more {
      display: flex;
      justify-content: center;
      margin: 32px 0 0;
    }
  }

  @include tab {
    .blog {
      &__list {
        grid-template-columns: 1fr;
      }
    }
  }
</style>
