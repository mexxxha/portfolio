---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { content } from '../data/content';
import SectionTitle from '../components/SectionTitle.astro';
import PillLink from '../components/PillLink.astro';

const { sectionTitles } = content;
const posts = (await getCollection('blog')).sort((a, b) =>
  b.data.date.localeCompare(a.data.date),
);
const items = posts.slice(0, 2);
const hasMore = posts.length > 2;
---

<section class="blog" id="blog">
  <div class="blog__inner">
    <SectionTitle content={sectionTitles.blog} />
    {
      items.length === 0 ? (
        <p class="blog__empty">{sectionTitles.blog.empty}</p>
      ) : (
        <>
          <ul class="blog__list">
            {items.map((entry) => (
              <li class="blog__item">
                <a class="blog__card" href={`/blog/${entry.id}`}>
                  {entry.data.thumbnail && (
                    <div class="blog__media">
                      <Image class="blog__image" src={entry.data.thumbnail} alt={entry.data.title} />
                    </div>
                  )}

                  <div class="blog__body">
                    <p class="blog__date">{entry.data.date}</p>
                    <h3 class="blog__title">{entry.data.title}</h3>
                    <p class="blog__desc">{entry.data.description}</p>

                    {entry.data.tags && (
                      <ul class="blog__tags">
                        {entry.data.tags.map((tag) => (
                          <li class="blog__tag_item">{tag}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                </a>
              </li>
            ))}
          </ul>

          {hasMore && (
            <p class="blog__more">
              <PillLink href="/blog">MORE</PillLink>
            </p>
          )}
        </>
      )
    }
  </div>
</section>

<style lang="scss">
  .blog {
    &__inner {
      max-width: 1100px;
      margin: 0 auto;
    }

    &__empty {
      text-align: center;
      margin: 32px 0 0;
      font-size: 0.8rem;
      letter-spacing: 0.06em;
      opacity: 0.7;
    }

    &__list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
      margin: 32px 0 0;
    }

    &__card {
      display: grid;
      gap: 16px;
      height: 100%;
      padding: 16px;
      border: 0.5px solid $c-border;
      border-radius: 8px;
      transition:
        border-color 0.4s ease,
        transform 0.4s ease;

      &:hover {
        border-color: $c-text;
        transform: translateY(-2px);
      }
    }

    &__media {
      aspect-ratio: 16 / 10;
      border-radius: 4px;
      overflow: hidden;
    }

    &__image {
      height: 100%;
      transition: transform 0.4s ease;

      .blog__card:hover & {
        transform: scale(1.03);
      }
    }

    &__body {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    &__date {
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      opacity: 0.7;
    }

    &__title {
      font-size: 1rem;
      line-height: 1.3;
    }

    &__desc {
      font-size: 0.7rem;
      opacity: 0.8;
    }

    &__tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 4px 0 0;
    }

    &__tag_item {
      border: 0.5px solid $c-border;
      border-radius: 999px;
      padding: 4px 10px;
      font-size: 0.6rem;
      letter-spacing: 0.06em;
    }

    &__more {
      display: flex;
      justify-content: center;
      margin: 32px 0 0;
    }
  }

  @include tab {
    .blog {
      &__list {
        grid-template-columns: 1fr;
      }
    }
  }
</style>
