---
import { content } from '../data/content';
import SectionTitle from '../components/SectionTitle.astro';
import SnsList from '../components/SnsList.astro';

const { sectionTitles, contact } = content;
---

<section class="contact" id="contact">
  <div class="contact__inner">
    <SectionTitle content={sectionTitles.contact} />

    <div class="contact__body">
      <p class="contact__lead">{contact.lead}</p>

      <SnsList />

      <p class="contact__more">
        <a class="contact__more_link" href={contact.formUrl} target="_blank" rel="noopener noreferrer">{contact.formLabel}</a>
      </p>
    </div>
  </div>
</section>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .contact {
    width: 100%;

    &__inner {
      max-width: 1100px;
      margin: 0 auto;
    }

    &__body {
      display: flex;
      flex-direction: column;
      max-width: 36rem;
      gap: 32px;
      margin: 48px auto;
    }

    &__lead {
      text-align: center;
      font-size: 0.8rem;
      letter-spacing: 0.08em;
      opacity: 0.7;
    }

    &__more {
      display: flex;
      justify-content: center;
    }

    &__more_link {
      display: inline-flex;
      justify-content: center;
      gap: 10px;
      padding: 10px 22px;
      border: 0.5px solid $c-border;
      border-radius: 999px;
      font-size: 0.7rem;
      letter-spacing: 0.2em;
      opacity: 0.7;
      transition:
        color 0.4s ease,
        background-color 0.4s ease,
        border-color 0.4s ease;

      &:hover {
        color: $c-text-a;
        background-color: $c-bg-a;
        border-color: $c-bg-a;
      }
    }
  }
</style>
