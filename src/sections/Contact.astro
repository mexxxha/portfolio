---
import { content } from '../data/content';
import SectionTitle from '../components/SectionTitle.astro';
import SnsList from '../components/SnsList.astro';
import PillLink from '../components/PillLink.astro';

const { sectionTitles, contact } = content;
---

<section class="contact" id="contact">
  <div class="contact__inner">
    <SectionTitle content={sectionTitles.contact} />

    <div class="contact__body">
      <p class="contact__lead">{contact.lead}</p>

      <SnsList />

      <p class="contact__more">
        <PillLink href={contact.formUrl} ariaLabel="お問い合わせフォームへ（新しいタブで開く）" external>{contact.formLabel}</PillLink>
      </p>
    </div>
  </div>
</section>

<style lang="scss">
  .contact {
    width: 100%;

    &__inner {
      max-width: 1100px;
      margin: 0 auto;
    }

    &__body {
      display: flex;
      flex-direction: column;
      max-width: 36rem;
      gap: 32px;
      margin: 48px auto;
    }

    &__lead {
      text-align: center;
      font-size: 0.8rem;
      letter-spacing: 0.08em;
      opacity: 0.7;
    }

    &__more {
      display: flex;
      justify-content: center;
    }
  }
</style>
