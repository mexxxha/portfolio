---
import { Image } from 'astro:assets';
import { content } from '../data/content';
import SectionTitle from '../components/SectionTitle.astro';

const { logo, hero, sectionTitles } = content;
const LogoIcon = logo.src;
---

<section class="hero">
  <Image class="hero__image" src={hero.image} alt={hero.imageAlt} layout="full-width" loading="eager" />
  <div class="hero__inner">
    <h1 class="hero__logo">
      <a href="/" class="hero__logo_link" aria-label="ホームへ戻る">
        <LogoIcon class="hero__logo_img" data-hero-logo aria-hidden="true" focusable="false" />
      </a>
    </h1>
    <div class="hero__bottom">
      <SectionTitle content={sectionTitles.hero} />
      <p class="hero__scroll">SCROLL</p>
    </div>
  </div>
</section>

<style lang="scss">
  .hero {
    position: relative;
    width: 100%;
    height: 100svh;

    &::before {
      position: absolute;
      content: '';
      top: 0;
      left: 0;
      display: block;
      width: 100%;
      height: 100%;
      background-color: $overlay;
      z-index: $z-base;
    }

    &__image {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: 0;
    }
    &__logo {
      z-index: $z-base + 2;

      &_img {
        width: auto;
        height: 50px; // ロゴサイズはここで調整
      }
    }

    &__inner {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      max-width: $inner;
      margin-inline: auto;
      z-index: $z-base + 1;
    }

    &__bottom {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }

    &__scroll {
      font-size: 0.6rem;
      letter-spacing: 0.4em;
      writing-mode: vertical-rl;
    }
  }
</style>
