---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { content } from '../data/content';
import SectionTitle from '../components/SectionTitle.astro';
import PillLink from '../components/PillLink.astro';

const { sectionTitles } = content;
const works = await getCollection('works');
const sorted = works.sort((a, b) => b.data.date.localeCompare(a.data.date));
const items = sorted.slice(0, 3);
const hasMore = sorted.length > 3;
---

<section class="works" id="works">
  <div class="works__inner">
    <SectionTitle content={sectionTitles.works} />
    {
      items.length === 0 ? (
        <p class="works__empty">{sectionTitles.works.empty}</p>
      ) : (
        <>
          <ul class="works__list">
            {items.map((entry) => (
              <li class="works__item">
                <a class="works__card" href={`/works/${entry.id}`} aria-label={`${entry.data.title}の詳細`}>
                  <div class="works__media">
                    <Image class="works__image" src={entry.data.thumbnail} alt={entry.data.title} />
                  </div>

                  <div class="works__body">
                    <p class="works__date">{entry.data.date}</p>
                    <h3 class="works__title">{entry.data.title}</h3>
                    <p class="works__desc">{entry.data.description}</p>

                    <ul class="works__tech">
                      {entry.data.tech.map((tech) => (
                        <li class="works__tech_item">{tech}</li>
                      ))}
                    </ul>
                  </div>
                </a>
              </li>
            ))}
          </ul>
          {hasMore && (
            <p class="works__more">
              <PillLink href="/works">MORE</PillLink>
            </p>
          )}
        </>
      )
    }
  </div>
</section>

<style lang="scss">
  .works {
    &__inner {
      max-width: 1100px;
      margin: 0 auto;
    }
    
    &__empty {
      text-align: center;
      margin: 32px 0 0;
      font-size: 0.8rem;
      letter-spacing: 0.06em;
      opacity: 0.7;
    }

    &__list {
      display: grid;
      grid-template-columns: 1fr;
      gap: 24px;
      margin: 32px 0 0;
    }

    &__card {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 24px;
      padding: 24px;
      border: 0.5px solid $c-border;
      border-radius: 8px;
      transition:
        border-color 0.4s ease,
        transform 0.4s ease;

      &:hover {
        border-color: $c-text;
        transform: translateY(-2px);
      }
    }

    &__media {
      aspect-ratio: 16 / 10;
      border-radius: 4px;
      overflow: hidden;
    }

    &__image {
      width: 100%;
      height: 100%;
      transition: transform 0.4s ease;

      .works__card:hover & {
        transform: scale(1.03);
      }
    }

    &__body {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 12px;
    }

    &__date {
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      opacity: 0.7;
    }

    &__title {
      font-size: 1rem;
      line-height: 1.2;
    }

    &__desc {
      font-size: 0.6rem;
      opacity: 0.8;
    }

    &__tech {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;

      &_item {
        padding: 4px 10px;
        border: 0.5px solid $c-border;
        border-radius: 999px;
        font-size: 0.6rem;
        letter-spacing: 0.06em;
      }
    }

    &__more {
      display: flex;
      justify-content: center;
      margin: 20px 0 0;
    }
  }

  @include tab {
    .works {
      &__card {
        grid-template-columns: 1fr;
      }
    }
  }
</style>
