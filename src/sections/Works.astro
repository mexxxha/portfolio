---
import { getCollection } from 'astro:content';
import { content } from '../data/content';
import SectionTitle from '../components/SectionTitle.astro';
import PillLink from '../components/PillLink.astro';
import WorkCard  from '../components/WorkCard.astro';

const { sectionTitles } = content;
const works = await getCollection('works');
const sorted = works.sort((a, b) => b.data.date.localeCompare(a.data.date));
const items = sorted.slice(0, 3);
const hasMore = sorted.length > 3;
---

<section class="works" id="works">
  <div class="works__inner">
    <SectionTitle content={sectionTitles.works} />
    {
      items.length === 0 ? (
        <p class="works__empty">{sectionTitles.works.empty}</p>
      ) : (
        <>
          <ul class="works__list">
            {items.map((entry) => (
              <WorkCard entry={entry} heading="h3" variant="row" />
            ) )}
          </ul>
          {hasMore && (
            <p class="works__more">
              <PillLink href="/works">MORE</PillLink>
            </p>
          )}
        </>
      )
    }
  </div>
</section>

<style lang="scss">
  .works {
    &__inner {
      max-width: 1100px;
      margin: 0 auto;
    }
    
    &__empty {
      text-align: center;
      margin: 32px 0 0;
      font-size: 0.8rem;
      letter-spacing: 0.06em;
      opacity: 0.7;
    }

    &__list {
      display: grid;
      grid-template-columns: 1fr;
      gap: 24px;
      margin: 32px 0 0;
    }

    &__more {
      display: flex;
      justify-content: center;
      margin: 20px 0 0;
    }
  }
</style>
